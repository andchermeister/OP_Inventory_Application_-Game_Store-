<li>
  <p>Genre name: <%= genre.genre_name %></p>
  <a href="/genres/<%= genre.id %>"><button>Open</button></a>
  <a href="/genres/<%= genre.id %>/edit"><button>Edit</button></a>
  <form
    action="/genres/<%= genre.id %>/delete"
    method="POST"
    style="display: inline"
  >
    <input
      type="password"
      name="password"
      placeholder="Enter admin password"
      required
    />
    <button type="submit">Delete genre</button>
  </form>
  <a href="/developers"><button>Genres</button></a>
</li>
