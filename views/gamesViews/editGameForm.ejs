<!DOCTYPE html>
<html lang="en">
  <% include("../partials/head") %>
  <body>
    <h1>Edit a game:</h1>
    <form action="/games/<%= game.id %>/edit" method="POST">
      <ul>

        <li>
          <label for="title">Title:</label>
          <input
            type="text"
            name="title"
            id="title"
            value="<%= game.title %>"
            required
          />
        </li>

        <li>
          <label for="genre">Genre:</label>
          <select name="genreId" id="genre" required>
            <% genres.forEach(genre => { %>
              <option value="<%= genre.id %>"
                 <%= genre.id === game.genre_id ? "selected" : "" %>
                 >
                <%= genre.genre_name %>
              </option>
            <%})%>
          </select>
        </li>

        <li>
          <label for="developer">Developer:</label>
          <select name="developerId" id="developer" required>
            <% developers.forEach(developer => { %>
              <option value="<%= developer.id %>"
                <%= developer.id === game.developer_id ? "selected" : "" %>
                >
                <%= developer.company_name %>
              </option>
            <%})%>
          </select>
        </li>

        <li>
          <label for="release_date">Release date:</label>
          <input type="date" name="release_date" id="release_date" value="<%= game.release_date.toISOString().substring(0, 10) %>" required />
        </li>

        <li>
          <label for="rating">Rating:</label>
          <input type="number" name="rating" id="rating" value="<%= game.rating %>" required />
        </li>

      </ul>
      <button type="submit">Save</button>
    </form>
  </body>
</html>
